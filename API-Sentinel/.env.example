# API Sentinel Environment Configuration
# Server
PORT=5000
NODE_ENV=development

# Database Configuration
# Option 1: Leave unset or unreachable to automatically use the zero-dependency Embedded Store / mongodb-memory-server
# Option 2: Local MongoDB instance: mongodb://127.0.0.1:27017/api_sentinel
# Option 3: MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/api_sentinel?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/api_sentinel
USE_MEMORY_DB=false

# Authentication
JWT_SECRET=api_sentinel_super_secret_jwt_key_2026_academic_production
JWT_EXPIRES_IN=24h

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Network & SSRF Security
ALLOW_LOCAL_NETWORK=true

